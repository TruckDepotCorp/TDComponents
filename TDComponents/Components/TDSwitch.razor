@namespace TDComponents.Components

<TDFormFlag Value="On" ValueChanged="ValueChanged" ValueExpression="ValueExpression" ExplicitName="@Name" Fallback="" Context="posted">
    <td-switch>
        <label class="td-switch @(SizeToken) @(LabelPosition == TDLabelPosition.Start ? "td-switch--start" : null) @(Disabled ? "is-disabled" : null)">
            @if (LabelPosition == TDLabelPosition.Start)
            {
                <span class="td-switch__text">@Label</span>
            }
            @if (!string.IsNullOrEmpty(posted))
            {
                <input type="hidden" name="@posted" value="false" />
            }
            <input class="td-sr"
                   type="checkbox"
                   name="@posted"
                   value="true"
                   checked="@On"
                   disabled="@Disabled"
                   role="switch"
                   aria-checked="@(On ? "true" : "false")" />
            <span class="td-switch__track" aria-hidden="true"><span class="td-switch__thumb"></span></span>
            @if (LabelPosition != TDLabelPosition.Start)
            {
                <span class="td-switch__text">@Label</span>
            }
        </label>
        @if (ValueExpression is not null)
        {
            <div class="td-field__server"><ValidationMessage For="ValueExpression" /></div>
        }
    </td-switch>
</TDFormFlag>

@code {
    /// <summary>Nombre del campo en el post. Activo envía <c>true</c> e inactivo envía <c>false</c>. Si se omite y el campo usa <c>@bind-Value</c>, el post usa el nombre del modelo.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Texto que dice qué cambia. El interruptor solo no alcanza.</summary>
    [Parameter] public string Label { get; set; } = "";

    /// <summary>Empieza activo. Si el campo usa <c>@bind-Value</c>, manda <see cref="Value"/>.</summary>
    [Parameter] public bool Checked { get; set; }

    /// <summary>La persona no puede cambiarlo.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Tamaño de la pista. <see cref="TDSize.Small"/>, <see cref="TDSize.Medium"/> o <see cref="TDSize.Large"/>.</summary>
    [Parameter] public TDSize Size { get; set; } = TDSize.Medium;

    /// <summary>Lado del texto. <see cref="TDLabelPosition.End"/> lo deja a la derecha. <see cref="TDLabelPosition.Start"/> lo deja a la izquierda.</summary>
    [Parameter] public TDLabelPosition LabelPosition { get; set; } = TDLabelPosition.End;

    private bool On => ValueExpression is not null || ValueChanged.HasDelegate ? Value : Checked;

    private string SizeToken => Size switch
    {
        TDSize.Small => "td-switch--sm",
        TDSize.Large => "td-switch--lg",
        _ => "td-switch--md"
    };
}
