@namespace TDComponents.Components

<td-compare class="td-compare"
            data-td-compare
            data-vertical="@(Vertical ? "true" : null)"
            data-follow="@(FollowMouse ? "true" : null)"
            style="--pos:50%">
    <span class="td-section-title">@Label</span>
    <div class="td-compare__stage" data-td-compare-stage>
        <div class="td-compare__after">
            <span class="td-compare__tag td-compare__tag--end">@AfterLabel</span>
        </div>
        <div class="td-compare__before" data-td-compare-before>
            <span class="td-compare__tag">@BeforeLabel</span>
        </div>
        <div class="td-compare__line" aria-hidden="true"></div>
        <button type="button"
                class="td-compare__knob"
                role="slider"
                aria-label="Posición del comparador"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="50"
                data-td-compare-knob>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18-6-6 6-6"></path><path d="m15 6 6 6-6 6"></path></svg>
        </button>
    </div>
    <span class="td-field__hint">
        @(FollowMouse ? "Mueve el mouse encima" : Vertical ? "Arrastra o usa ↑ ↓" : "Arrastra o usa ← →")
        · <span data-td-compare-pos>50%</span>
    </span>
</td-compare>

@code {
    /// <summary>Título del comparador.</summary>
    [Parameter] public string Label { get; set; } = "Horizontal · arrastrar";
    /// <summary>Etiqueta del estado anterior.</summary>
    [Parameter] public string BeforeLabel { get; set; } = "Antes · disco usado 36 mm";
    /// <summary>Etiqueta del estado posterior.</summary>
    [Parameter] public string AfterLabel { get; set; } = "Después · disco nuevo 45 mm";
    /// <summary>La división se arrastra en vertical.</summary>
    [Parameter] public bool Vertical { get; set; }
    /// <summary>La división sigue al mouse sin mantener pulsado.</summary>
    [Parameter] public bool FollowMouse { get; set; }
}
