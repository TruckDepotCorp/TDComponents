@namespace TDComponents.Components
@typeparam TItem
@using TDComponents.Data

<CascadingValue Value="this" IsFixed="true">
    @Columns
</CascadingValue>

@if (_columns.Count > 0)
{
    var view = View();
    var clearHref = ClearHref(view);
    <td-data-grid class="td-grid" data-density="comfortable" data-settings="@QueryKey" data-resize="@(AllowResize ? "true" : null)" data-reorder="@(AllowReorder ? "true" : null)" data-context-menu="@(ContextMenu ? "true" : null)">
        <div class="td-grid__card">
            <form id="@SearchFormId" class="td-grid__toolbar" method="get" action="@Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath" data-enhance data-td-search-form hidden="@(!ShowSearch && !ShowTools)">
                <div class="td-grid__search" hidden="@(!ShowSearch)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                    <input type="search" name="@NameOf("q")" value="@view.Search" placeholder="@SearchPlaceholder" aria-label="@SearchPlaceholder" autocomplete="off" />
                </div>
                @if (!string.IsNullOrEmpty(view.SortKey))
                {
                    <input type="hidden" name="@NameOf("sort")" value="@view.SortKey" />
                    <input type="hidden" name="@NameOf("dir")" value="@(view.Descending ? "desc" : "asc")" />
                }
                @if (!string.IsNullOrEmpty(view.FilterText))
                {
                    <input type="hidden" name="@NameOf("f")" value="@view.FilterText" data-td-filter-field />
                }
                else
                {
                    <input type="hidden" name="@NameOf("f")" value="" data-td-filter-field />
                }
                @if (view.PageSize != PageSize)
                {
                    <input type="hidden" name="@NameOf("size")" value="@view.PageSize" />
                }
                @if (!string.IsNullOrEmpty(view.Category))
                {
                    <input type="hidden" name="@NameOf("cat")" value="@view.Category" />
                }
                @if (!string.IsNullOrEmpty(view.Group))
                {
                    <input type="hidden" name="@NameOf("tipo")" value="@view.Group" />
                }
                <div class="td-grid__spacer"></div>
                @if (ShowTools)
                {
                <div class="td-grid__segment" role="group" aria-label="Densidad">
                    <button type="button" data-td-density="compact" aria-pressed="false">Compacta</button>
                    <button type="button" data-td-density="comfortable" aria-pressed="true">Normal</button>
                </div>
                <button type="button" class="td-grid__icon" data-td-lines aria-pressed="false" aria-label="Líneas de cuadrícula" title="Líneas de cuadrícula">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18M3 15h18M9 3v18M15 3v18"></path></svg>
                </button>
                <div class="td-grid__menu">
                    <button type="button" class="td-grid__tool" data-td-columns aria-haspopup="true" aria-expanded="false">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18M15 3v18"></path></svg>
                        Columnas
                    </button>
                    <div class="td-grid__picker" data-td-column-picker hidden role="menu">
                        @foreach (var column in _columns)
                        {
                            <button type="button" role="menuitemcheckbox" data-td-column="@column.Key" aria-checked="@column.Visible" disabled="@(!column.Pickable)">
                                <span class="td-grid__box" aria-hidden="true"></span>
                                @column.Title
                            </button>
                        }
                    </div>
                </div>
                <button type="button" class="td-grid__tool" data-td-export>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5M12 15V3"></path></svg>
                    CSV
                </button>
                @if (!string.IsNullOrEmpty(ExcelHref))
                {
                    <a class="td-grid__tool" href="@ExcelHref">Excel</a>
                }
                }
            </form>

            @if (view.Filters.Count > 0 || !string.IsNullOrEmpty(view.Search))
            {
                <div class="td-grid__chips">
                    <span class="td-grid__chips-label">Filtros</span>
                    @if (!string.IsNullOrEmpty(view.Search))
                    {
                        <a class="td-grid__chip" href="@RemoveSearchHref(view)">Búsqueda "@view.Search"</a>
                    }
                    @foreach (var filter in view.Filters)
                    {
                        <a class="td-grid__chip" href="@RemoveFilterHref(view, filter.Key)">@ChipLabel(filter)</a>
                    }
                    <a class="td-grid__clear" href="@clearHref">Limpiar todo</a>
                </div>
            }

            <form id="@SizeFormId" method="get" action="@Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath" data-enhance class="td-grid__sizeform">
                @foreach (var field in SizeFields(view))
                {
                    if (!string.IsNullOrEmpty(field.Value))
                    {
                        <input type="hidden" name="@field.Key" value="@field.Value" />
                    }
                }
            </form>

            @if (!string.IsNullOrEmpty(FormName))
            {
                <form method="post" @formname="@FormName" @onsubmit="OnSubmit" data-enhance>
                    @GridBody(view)
                    <div class="td-grid__savebar">
                        <p class="td-grid__status" data-td-status role="status">
                            @(SavedCount > 0
                                ? $"Guardado · {SavedCount} {(SavedCount == 1 ? "fila actualizada" : "filas actualizadas")}"
                                : SaveHint ?? "Edita el stock en la tabla y guarda en lote.")
                        </p>
                        <button type="button" class="td-grid__tool" data-td-discard>Descartar</button>
                        <TDButton PendingText="Guardando…">Guardar cambios</TDButton>
                    </div>
                </form>
            }
            else
            {
                @GridBody(view)
                @if (Selection == TDSelectionMode.Multiple)
                {
                    <p class="td-grid__status td-grid__status--plain" data-td-status role="status">Selecciona filas. Con Shift marcas un rango.</p>
                }
            }

            <div class="td-grid__popover" data-td-filter hidden role="dialog" aria-label="Filtro de columna">
                <p class="td-grid__popover-title" data-td-filter-title>Filtrar</p>
                <div data-td-checklist hidden></div>
                <div data-td-advanced>
                <select data-td-op="1" data-for="text" aria-label="Condición 1">
                    <option value="contains">Contiene</option>
                    <option value="eq">Igual a</option>
                    <option value="neq">Distinto de</option>
                    <option value="starts">Empieza con</option>
                    <option value="ends">Termina con</option>
                    <option value="ncontains">No contiene</option>
                    <option value="empty">Está vacío</option>
                    <option value="nempty">No está vacío</option>
                </select>
                <select data-td-op="1" data-for="num" aria-label="Condición 1" hidden>
                    <option value="eq">Igual a</option>
                    <option value="neq">Distinto de</option>
                    <option value="lt">Menor que</option>
                    <option value="lte">Menor o igual a</option>
                    <option value="gt">Mayor que</option>
                    <option value="gte">Mayor o igual a</option>
                </select>
                <input data-td-value="1" aria-label="Valor 1" placeholder="Valor" />
                <div class="td-grid__segment" role="group" aria-label="Combinar condiciones">
                    <button type="button" data-td-logic="and" aria-pressed="true">Y</button>
                    <button type="button" data-td-logic="or" aria-pressed="false">O</button>
                </div>
                <select data-td-op="2" data-for="text" aria-label="Condición 2">
                    <option value="contains">Contiene</option>
                    <option value="eq">Igual a</option>
                    <option value="neq">Distinto de</option>
                    <option value="starts">Empieza con</option>
                    <option value="ends">Termina con</option>
                    <option value="ncontains">No contiene</option>
                    <option value="empty">Está vacío</option>
                    <option value="nempty">No está vacío</option>
                </select>
                <select data-td-op="2" data-for="num" aria-label="Condición 2" hidden>
                    <option value="eq">Igual a</option>
                    <option value="neq">Distinto de</option>
                    <option value="lt">Menor que</option>
                    <option value="lte">Menor o igual a</option>
                    <option value="gt">Mayor que</option>
                    <option value="gte">Mayor o igual a</option>
                </select>
                <input data-td-value="2" aria-label="Valor 2" placeholder="Valor (opcional)" />
                </div>
                <div class="td-grid__popover-actions">
                    <button type="button" class="td-grid__tool" data-td-filter-clear>Limpiar</button>
                    <button type="button" class="td-grid__apply" data-td-filter-apply>Aplicar</button>
                </div>
            </div>
            <div class="td-grid__menu td-grid__cellmenu" data-td-cell-menu hidden role="menu" aria-label="Acciones de celda"></div>

            @if (ShowQuery)
            {
                <div class="td-grid__query">
                    <div class="td-grid__query-head">
                        <span>IQueryable</span>
                        <span>@view.Total coincidencias · @view.Rows.Count en esta página</span>
                    </div>
                    <pre>@view.Linq</pre>
                    <span class="td-grid__query-url">GET @PageHref(view, view.Page)</span>
                </div>
            }
        </div>
        <script type="application/json" data-td-export-json>@((MarkupString)view.ExportJson)</script>
    </td-data-grid>
}

@code {
    private RenderFragment<GridSnapshot> GridBody => view =>
        @<text>
            <div class="td-grid__scroll">
                <table aria-label="@AriaLabel">
                    <thead>
                        @if (Groups().Count > 0)
                        {
                            <tr class="td-grid__groups">
                                @if (ShowChecks)
                                {
                                    <th></th>
                                }
                                @foreach (var group in Groups())
                                {
                                    <th colspan="@group.Span">@group.Title</th>
                                }
                            </tr>
                        }
                        <tr>
                            @if (ShowChecks)
                            {
                                <th class="td-grid__check">
                                    <input class="td-check" type="checkbox" data-td-select-all aria-label="Seleccionar página" />
                                </th>
                            }
                            @foreach (var column in _columns)
                            {
                                var sorted = SortIndex(view, column);
                                <th scope="col" data-col="@column.Key" hidden="@(!column.Visible)" draggable="@(AllowReorder ? "true" : null)" tabindex="@(AllowReorder ? 0 : null)" aria-sort="@SortAria(view, column)" style="@(column.Width > 0 ? $"width:{column.Width}px" : null)" class="@($"{(column.Align == TDColumnAlign.End ? "is-end" : null)} {FreezeClass(column)}".Trim())">
                                    <div class="td-grid__head">
                                        @if (AllowReorder)
                                        {
                                            <span class="td-grid__grip" aria-hidden="true"></span>
                                        }
                                        @if (column.Sortable)
                                        {
                                            <a href="@SortHref(view, column)" class="@(sorted is not null ? "is-active" : null)">
                                                @column.Title
                                                @if (MultiSort && sorted is int index)
                                                {
                                                    <span class="td-grid__sortindex">@(index + 1)</span>
                                                }
                                                <span class="td-grid__sort" aria-hidden="true">@(sorted is null ? "↕" : SortDescending(view, column) ? "↓" : "↑")</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span>@column.Title</span>
                                        }
                                        @if (ShowFunnel(column))
                                        {
                                            <button type="button" class="td-grid__filter @(view.Filters.Any(filter => filter.Key == column.Key) ? "is-active" : null)" data-td-filter-open data-col="@column.Key" data-type="@(IsCheckList(column) ? "list" : column.FilterType)" data-title="@column.Title" data-values="@(IsCheckList(column) ? DistinctJson(column) : null)" data-current="@EncodedFilter(view.Filters.FirstOrDefault(filter => filter.Key == column.Key))" aria-label="@($"Filtrar {column.Title}")">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"></path></svg>
                                            </button>
                                        }
                                    </div>
                                    @if (AllowResize)
                                    {
                                        <span class="td-grid__resize" role="separator" aria-orientation="vertical" data-td-resize data-col="@column.Key" aria-label="@($"Redimensionar {column.Title}")"></span>
                                    }
                                </th>
                            }
                        </tr>
                        @if (_columns.Any(InFilterRow))
                        {
                            <tr class="td-grid__filterrow">
                                @if (ShowChecks)
                                {
                                    <th></th>
                                }
                                @foreach (var column in _columns)
                                {
                                    <th data-col="@column.Key" hidden="@(!column.Visible)">
                                        @if (InFilterRow(column))
                                        {
                                            <div class="td-grid__filtercell">
                                                @if (ModeOf(column) == TDFilterMode.Menu)
                                                {
                                                    <select form="@SearchFormId" name="@NameOf("op-" + column.Key)" data-td-filter-op aria-label="@($"Operador de {column.Title}")">
                                                        @if (column.FilterType == "text")
                                                        {
                                                            <option value="contains" selected="@(SimpleOp(view, column) == "contains")">*A*</option>
                                                            <option value="eq" selected="@(SimpleOp(view, column) == "eq")">=</option>
                                                            <option value="starts" selected="@(SimpleOp(view, column) == "starts")">A**</option>
                                                            <option value="ncontains" selected="@(SimpleOp(view, column) == "ncontains")">!*A*</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="eq" selected="@(SimpleOp(view, column) == "eq")">=</option>
                                                            <option value="gt" selected="@(SimpleOp(view, column) == "gt")">&gt;</option>
                                                            <option value="lt" selected="@(SimpleOp(view, column) == "lt")">&lt;</option>
                                                            <option value="gte" selected="@(SimpleOp(view, column) == "gte")">≥</option>
                                                            <option value="lte" selected="@(SimpleOp(view, column) == "lte")">≤</option>
                                                        }
                                                    </select>
                                                }
                                                <input form="@SearchFormId" name="@NameOf("v-" + column.Key)" value="@SimpleValue(view, column)" data-td-filter-value placeholder="Filtrar" aria-label="@($"Filtrar {column.Title}")" />
                                            </div>
                                        }
                                    </th>
                                }
                            </tr>
                        }
                    </thead>
                    <tbody>
                        @foreach (var item in view.Rows)
                        {
                            <tr class="@RowCss(item)" aria-selected="@(Selection == TDSelectionMode.Single && RowId is not null && SelectedId == RowId(item) ? "true" : null)">
                                @if (ShowChecks)
                                {
                                    <td class="td-grid__check" data-col="__check">
                                        <input class="td-check" type="checkbox" data-td-select aria-label="Seleccionar fila" />
                                    </td>
                                }
                                @foreach (var column in _columns)
                                {
                                    <td data-col="@column.Key" hidden="@(!column.Visible)" data-td-cell data-copy="@column.Display(item)" data-title="@column.Title" data-filter-href="@EqHref(view, column, item)" data-sort-asc="@SortDirectionHref(view, column, false)" data-sort-desc="@SortDirectionHref(view, column, true)" data-ficha="@(RowId is null ? null : SelectHref(item))" class="@($"{(column.Align == TDColumnAlign.End ? "is-end" : null)} {FreezeClass(column)}".Trim())">
                                        @if (column.Template is not null)
                                        {
                                            @column.Template(item)
                                        }
                                        else if (column.Kind == TDColumnKind.Thumb)
                                        {
                                            <span class="td-grid__thumb">@column.ThumbText(item)</span>
                                        }
                                        else if (column.Kind == TDColumnKind.Stock && RowId is not null && !string.IsNullOrEmpty(FormName))
                                        {
                                            var state = StockState(column.Read(item));
                                            var stock = StockValue(column, item);
                                            <div class="td-stock">
                                                <input type="number" min="0" name="@($"Stock[{RowId(item)}]")" value="@stock" data-original="@stock" aria-label="@($"Stock {RowId(item)}")" data-td-stock />
                                                <span class="td-stock__state @state.ClassName" data-td-stock-state>@state.Label</span>
                                            </div>
                                        }
                                        else if (column.Kind == TDColumnKind.Pill)
                                        {
                                            <span class="td-grid__pill">@column.Display(item)</span>
                                        }
                                        else if (Selection == TDSelectionMode.Single && column.Key == _columns.FirstOrDefault(candidate => candidate.Sortable && candidate.Template is null)?.Key)
                                        {
                                            <a href="@SelectHref(item)">@column.Display(item)</a>
                                        }
                                        else
                                        {
                                            <span class="@CellClass(column)">@column.Display(item)</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    @if (ShowFooter)
                    {
                        <tfoot>
                            <tr>
                                @if (ShowChecks)
                                {
                                    <td></td>
                                }
                                @foreach (var column in _columns)
                                {
                                    var footer = view.Footers.GetValueOrDefault(column.Key);
                                    <td data-col="@column.Key" hidden="@(!column.Visible)" class="@FreezeClass(column)">
                                        @if (footer is not null)
                                        {
                                            <span class="td-grid__foot">
                                                <span>@footer.Label</span>
                                                <strong>@footer.Value</strong>
                                            </span>
                                        }
                                    </td>
                                }
                            </tr>
                        </tfoot>
                    }
                </table>
                @if (view.Rows.Count == 0)
                {
                    <div class="td-grid__empty">
                        <p>@EmptyTitle</p>
                        <p>@EmptyDetail</p>
                        <a class="td-grid__tool" href="@ClearHref(view)">Limpiar filtros</a>
                    </div>
                }
            </div>
            <TDPager Count="view.Total" Page="view.Page" PageSize="view.PageSize" PageSizeOptions="PageSizeOptions" HrefForPage="page => PageHref(view, page)" SizeFieldName="@NameOf("size")" SizeFormId="@SizeFormId" />
        </text>;
}

