@namespace TDComponents.Components

<div class="td-choice @(Cards ? "td-choice--cards" : null) @(Orientation == TDOrientation.Horizontal ? "td-choice--row" : null)" role="radiogroup" aria-label="@Label">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <p class="td-section-title">@Label</p>
    }
    @foreach (var option in Options)
    {
        <label class="td-radio @(option.Disabled ? "is-disabled" : null) @(Selected == option.Value ? "is-on" : null)">
            <input class="td-sr"
                   type="radio"
                   name="@Name"
                   value="@option.Value"
                   checked="@(Selected == option.Value)"
                   disabled="@option.Disabled" />
            <span class="td-radio__dot" aria-hidden="true"></span>
            <span class="td-radio__body">
                <span class="td-radio__label">@option.Label</span>
                @if (!string.IsNullOrWhiteSpace(option.Hint))
                {
                    <span class="td-radio__hint">@option.Hint</span>
                }
            </span>
        </label>
    }
</div>

@code {
    /// <summary>Nombre del grupo. Solo una opción llega al post.</summary>
    [Parameter] public string Name { get; set; } = "opcion";

    /// <summary>Título del grupo. También es el nombre accesible.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Opciones. Se usan <c>Label</c>, <c>Value</c>, <c>Hint</c> y <c>Disabled</c>.</summary>
    [Parameter] public IReadOnlyList<TDOption> Options { get; set; } = [];

    /// <summary><c>Value</c> de la opción inicial.</summary>
    [Parameter] public string? Selected { get; set; }

    /// <summary>Cada opción se presenta como tarjeta. Úsalo cuando el <c>Hint</c> ayuda a decidir.</summary>
    [Parameter] public bool Cards { get; set; }

    /// <summary><see cref="TDOrientation.Vertical"/> las apila. <see cref="TDOrientation.Horizontal"/> las pone en fila si el texto es corto.</summary>
    [Parameter] public TDOrientation Orientation { get; set; } = TDOrientation.Vertical;
}
