@namespace TDComponents.Components

<svg class="td-mxico" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "menu":
            <path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" />
            break;
        case "close":
            <path d="M18 6 6 18" /><path d="m6 6 12 12" />
            break;
        case "plus":
            <path d="M5 12h14" /><path d="M12 5v14" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
            break;
        case "receipt":
            <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z" /><path d="M16 8h-6" /><path d="M16 12h-6" />
            break;
        case "bag":
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" /><path d="M3 6h18" /><path d="M16 10a4 4 0 0 1-8 0" />
            break;
        case "cash":
            <path d="M2 7h20v13H2z" /><path d="M16 14h.01" /><path d="M2 11h20" />
            break;
        case "box":
            <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" /><path d="M12 22V12" />
            break;
        case "lock":
            <rect width="18" height="11" x="3" y="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
            break;
        case "alert":
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" /><path d="M12 9v4" /><path d="M12 17h.01" />
            break;
        case "users":
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
            break;
        case "clock":
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /><path d="M12 7v5l4 2" />
            break;
        case "check":
            <path d="M21.801 10A10 10 0 1 1 17 3.335" /><path d="m9 11 3 3L22 4" />
            break;
        case "pin":
            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" /><circle cx="12" cy="10" r="3" />
            break;
        case "trend":
            <path d="m22 7-8.5 8.5-5-5L2 17" /><path d="M16 7h6v6" />
            break;
        case "edit":
            <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
            break;
        case "home":
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="M9 22V12h6v10" />
            break;
        default:
            <path d="M5 12h14" />
            break;
    }
</svg>

@code {
    /// <summary>Nombre del ícono de línea: menu, plus, search, receipt, bag, cash, box, lock, alert, users, clock, check, pin, trend, edit, home.</summary>
    [Parameter] public string Name { get; set; } = "plus";

    /// <summary>Lado del ícono, en píxeles.</summary>
    [Parameter] public int Size { get; set; } = 20;
}
