@namespace TDComponents.Components
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.DependencyInjection

<td-button variant="@VariantToken" size="@SizeToken" block="@Block">
    @if (IsLink)
    {
        <a @attributes="AdditionalAttributes"
           class="@ModifierClass"
           href="@(Disabled ? null : Href)"
           aria-disabled="@(Disabled ? "true" : null)"
           tabindex="@(Disabled ? "-1" : null)">
            <span class="td-btn__label">@ChildContent</span>
        </a>
    }
    else
    {
        <button @attributes="Attributes"
                class="@ModifierClass"
                type="@TypeToken"
                data-td-click="@ClickToken"
                data-td-token="@(ClickToken is null ? null : Antiforgery)"
                disabled="@Disabled">
            <span class="td-btn__label">@ChildContent</span>
            @if (ButtonType == TDButtonType.Submit)
            {
                <span class="td-btn__pending" aria-hidden="true">
                    <span class="td-btn__spinner" aria-hidden="true"></span>
                    <span class="td-btn__pending-text">@PendingText</span>
                </span>
            }
        </button>
    }
</td-button>

@code {
    /// <summary>Jerarquía visual. <see cref="TDVariant.Primary"/> es la acción principal; <see cref="TDVariant.Secondary"/> la alternativa; <see cref="TDVariant.Ghost"/> la terciaria; <see cref="TDVariant.Danger"/> la destructiva.</summary>
    [Parameter] public TDVariant Variant { get; set; } = TDVariant.Primary;

    /// <summary>Tamaño del botón. <see cref="TDSize.Small"/> en barras densas, <see cref="TDSize.Medium"/> por defecto, <see cref="TDSize.Large"/> para destacarlo.</summary>
    [Parameter] public TDSize Size { get; set; } = TDSize.Medium;

    /// <summary>Qué hace dentro de un formulario. El defecto <see cref="TDButtonType.Submit"/> envía. <see cref="TDButtonType.Button"/> no envía. <see cref="TDButtonType.Reset"/> limpia los campos.</summary>
    [Parameter] public TDButtonType ButtonType { get; set; } = TDButtonType.Submit;

    /// <summary>Si tiene un URL seguro, el control se pinta como enlace. Se ignoran destinos que empiezan por <c>javascript:</c> o <c>data:</c>.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Impide activarlo. En un enlace también quita el destino y lo saca del tabulador.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Ocupa todo el ancho del contenedor. Úsalo en un formulario de una columna.</summary>
    [Parameter] public bool Block { get; set; }

    /// <summary>Texto visible durante el envío. Solo se pinta cuando <see cref="ButtonType"/> es <see cref="TDButtonType.Submit"/>. El defecto está en inglés: en español usa «Enviando…».</summary>
    [Parameter] public string PendingText { get; set; } = "Please wait…";

    /// <summary>Etiqueta del botón. Puede incluir un ícono.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private HttpContext? Http { get; set; }

    [Inject] private IServiceProvider Services { get; set; } = default!;

    /// <summary>Atributos HTML que este componente no declara, por ejemplo un <c>id</c> o un <c>data-*</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string? _clickToken;

    /// <summary>Token cifrado del <c>@onclick</c> del botón. Solo con <see cref="TDButtonType.Button"/>.</summary>
    private string? ClickToken => _clickToken;

    private string? Antiforgery => Http is null ? null : Services.GetService<IAntiforgery>()?.GetAndStoreTokens(Http).RequestToken;

    private Dictionary<string, object>? Attributes { get; set; }

    protected override void OnParametersSet()
    {
        _clickToken = null;
        Attributes = AdditionalAttributes;
        if (ButtonType != TDButtonType.Button || Http is null || AdditionalAttributes is null || !AdditionalAttributes.TryGetValue("onclick", out var handler))
        {
            return;
        }

        _clickToken = TDEventTokens.Create(Services, handler);
        if (_clickToken is not null)
        {
            Attributes = new Dictionary<string, object>(AdditionalAttributes);
            Attributes.Remove("onclick");
        }
    }

    private bool IsLink => IsSafeHref;

    private bool IsSafeHref =>
        !string.IsNullOrWhiteSpace(Href)
        && !Href.TrimStart().StartsWith("javascript:", StringComparison.OrdinalIgnoreCase)
        && !Href.TrimStart().StartsWith("data:", StringComparison.OrdinalIgnoreCase);

    private string VariantToken => Variant switch
    {
        TDVariant.Secondary => "secondary",
        TDVariant.Ghost => "ghost",
        TDVariant.Danger => "danger",
        _ => "primary"
    };

    private string SizeToken => Size switch
    {
        TDSize.Small => "sm",
        TDSize.Large => "lg",
        _ => "md"
    };

    private string TypeToken => ButtonType switch
    {
        TDButtonType.Button => "button",
        TDButtonType.Reset => "reset",
        _ => "submit"
    };

    private string ModifierClass =>
        $"td-btn td-btn--{VariantToken} td-btn--{SizeToken}{(Block ? " td-btn--block" : "")}";
}
