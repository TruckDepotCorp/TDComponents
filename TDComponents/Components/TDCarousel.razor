@namespace TDComponents.Components

<td-carousel data-interval="@Interval">
    <div class="td-carousel" data-td-carousel role="region" aria-roledescription="carrusel" aria-label="@AriaLabel">
        <div class="td-carousel__viewport">
            <div class="td-carousel__track" data-td-carousel-track>
                @for (var i = 0; i < Slides.Count; i++)
                {
                    var slide = Slides[i];
                    <div class="td-carousel__slide"
                         role="group"
                         aria-roledescription="diapositiva"
                         aria-label="@($"{i + 1} de {Slides.Count}")"
                         style="@($"background:{slide.Background}")">
                        <span class="td-carousel__eyebrow" style="@($"color:{slide.Accent}")">@slide.Eyebrow</span>
                        <span class="td-carousel__title">@slide.Title</span>
                        <span class="td-carousel__text">@slide.Text</span>
                        <span class="td-carousel__cta">@slide.Action</span>
                    </div>
                }
            </div>
        </div>
        <button type="button" class="td-carousel__nav td-carousel__nav--prev" data-td-carousel-prev aria-label="Anterior">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
        </button>
        <button type="button" class="td-carousel__nav td-carousel__nav--next" data-td-carousel-next aria-label="Siguiente">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
        </button>
        <div class="td-carousel__dots">
            @for (var i = 0; i < Slides.Count; i++)
            {
                <button type="button"
                        class="@(i == 0 ? "is-current" : null)"
                        data-td-carousel-dot="@i"
                        aria-label="@($"Ir a {i + 1}")"
                        aria-current="@(i == 0 ? "true" : null)"></button>
            }
        </div>
        <button type="button" class="td-carousel__play" data-td-carousel-play aria-label="Pausar">
            <svg data-icon="pause" width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
        </button>
    </div>
</td-carousel>

@code {
    /// <summary>Nombre accesible del carrusel.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Destacados";
    /// <summary>Milisegundos entre diapositivas. El defecto es 5000. La rotación se pausa al pasar el mouse.</summary>
    [Parameter] public int Interval { get; set; } = 5000;
    /// <summary>Diapositivas. Cada una es un TDSlide.</summary>
    [Parameter] public IReadOnlyList<TDSlide> Slides { get; set; } = [];
}
