@namespace TDComponents.Components

@if (Disabled)
{
    <span class="td-link is-disabled" aria-disabled="true">@ChildContent</span>
}
else
{
    <a class="td-link @(Quiet ? "td-link--quiet" : null) @(Button ? "td-btn td-btn--secondary td-btn--sm" : null)"
       href="@Href"
       target="@(External ? "_blank" : null)"
       rel="@(External ? "noopener noreferrer" : null)">
        @ChildContent
        @if (External)
        {
            <span class="td-sr"> (se abre en una pestaña nueva)</span>
        }
    </a>
}

@code {
    /// <summary>Destino. El defecto es un ancla vacía.</summary>
    [Parameter] public string Href { get; set; } = "#";
    /// <summary>Abre en otra pestaña y lo anuncia.</summary>
    [Parameter] public bool External { get; set; }
    /// <summary>Lo dibuja sin el énfasis del enlace normal.</summary>
    [Parameter] public bool Quiet { get; set; }
    /// <summary>Lo dibuja como botón. Sigue siendo un enlace y no envía formularios.</summary>
    [Parameter] public bool Button { get; set; }
    /// <summary>No se puede activar y sale del tabulador.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Texto del enlace.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
