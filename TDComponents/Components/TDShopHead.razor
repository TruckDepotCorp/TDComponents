@namespace TDComponents.Components

<div class="td-mxhead">
    <div>
        @if (!string.IsNullOrWhiteSpace(Kicker))
        {
            <div class="td-mxkicker">@Kicker</div>
        }
        <h2 class="td-mxtitle">@Title</h2>
    </div>
    @if (Actions is not null)
    {
        <div class="td-mxhead__actions">@Actions</div>
    }
</div>

@code {
    /// <summary>Línea pequeña sobre el título: fecha, sucursal o módulo.</summary>
    [Parameter] public string? Kicker { get; set; }

    /// <summary>Título de la pantalla.</summary>
    [Parameter] public string Title { get; set; } = "Inicio";

    /// <summary>Botones a la derecha del título.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
