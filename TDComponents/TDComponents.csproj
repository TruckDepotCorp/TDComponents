<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TDComponents</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <StaticWebAssetBasePath>TDComponents</StaticWebAssetBasePath>
    <DefaultItemExcludes>$(DefaultItemExcludes);ScriptsTS\node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="ScriptsTS\**" />
    <None Include="ScriptsTS\**" Exclude="ScriptsTS\node_modules\**" />
  </ItemGroup>

  <Target Name="BuildTdClient" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true' and Exists('ScriptsTS\node_modules\vite\package.json')">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/ScriptsTS" />
  </Target>

</Project>
