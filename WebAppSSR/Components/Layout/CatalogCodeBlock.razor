@using WebAppSSR.Catalog

<div class="td-code">
    <div class="td-code__bar">
        <span class="td-code__file">@Code.File</span>
        <span class="td-code__lang">@Code.Lang</span>
        <span class="td-code__spacer"></span>
        <button type="button" class="td-code__copy" data-td-copy aria-label="Copiar">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
            <span data-td-copy-label>Copiar</span>
        </button>
    </div>
    <pre><code data-td-copy-source>@Code.Source</code></pre>
</div>

@code {
    [Parameter, EditorRequired] public CatalogCode Code { get; set; } = default!;
}
