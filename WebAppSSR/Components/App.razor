<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <base href="/" />
    <script>
        (function () {
            var year = 60 * 60 * 24 * 365;
            function read(name) {
                var key = name + "=";
                var parts = document.cookie.split("; ");
                for (var i = 0; i < parts.length; i++) {
                    if (parts[i].indexOf(key) === 0) {
                        return decodeURIComponent(parts[i].substring(key.length));
                    }
                }
                return null;
            }
            function write(name, value) {
                var secure = location.protocol === "https:" ? "; Secure" : "";
                document.cookie = name + "=" + encodeURIComponent(value) + "; Max-Age=" + year + "; Path=/; SameSite=Lax" + secure;
            }
            function stored(name) {
                var value = read(name);
                if (value) return value;
                try {
                    value = localStorage.getItem(name);
                    if (value) {
                        write(name, value);
                        localStorage.removeItem(name);
                    }
                } catch (e) { }
                return value;
            }
            try {
                var scheme = stored("td-theme");
                var theme = scheme === "dark" || scheme === "light"
                    ? scheme
                    : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                document.documentElement.setAttribute("data-theme", theme);
                var family = stored("td-theme-family");
                if (family === "material" || family === "expressive" || family === "fluent") {
                    document.documentElement.setAttribute("data-td-theme", family);
                }
            } catch (e) {
                document.documentElement.setAttribute("data-theme", "light");
            }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Roboto+Flex:opsz,wght@8..144,400..900&family=Roboto+Mono:wght@400;500&family=Roboto:wght@400;500;700&family=Saira+Condensed:ital,wght@0,700;0,800;1,800;1,900&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,500,0,0&icon_names=arrow_back,arrow_forward,pause,play_arrow,open_in_new,photo_camera&display=swap" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["WebAppSSR.styles.css"]" />
    <link rel="stylesheet" href="@Assets["TDComponents/css/td.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script type="module" src="@Assets["TDComponents/js/td.js"]"></script>
</body>

</html>
